# This file is read by a SOURCE CHECKOUT and by Python API consumers. It is
# found by walking up from the installed library's own directory, so an
# installed server (uvx, pipx, a venv outside your tree) will not see it --
# there, set these as real environment variables instead. An MCP host does that
# through its own config, which is what docs/internal/mcp-setup.md recommends
# and is more reliable than a file whose location depends on the host.

# litellm gateway
LITELLM_MASTER_KEY=sk-your-key-here
LITELLM_BASE_URL=https://your-litellm-gateway.example.com

# Optional. Whether to verify the gateway's TLS certificate. Unset (the
# default) means VERIFY -- LITELLM_MASTER_KEY travels on this channel, so an
# unverified connection is one an interposer can read, and it succeeds exactly
# like a verified one.
#
# Set it to false (also 0, no, off) only for a gateway whose certificate the
# local trust store cannot accept -- typically an internal CA missing from the
# image, or a self-signed cert on localhost. Adding that CA to the trust store
# is the better fix. A certificate that fails verification now raises
# LlmTlsVerificationError from build(), naming this variable, rather than
# quietly producing an index with no ToC entries.
# LITELLM_TLS_VERIFY=

# Optional. The model used for section summaries and the ToC fallback, which
# runs automatically whenever a datasheet's bookmarks are missing or unusable.
# Unset (the default) means qwen3.8-27b. Set it when your gateway serves something
# else -- a name it does not serve fails every call, and there is no other way
# to change what the automatic fallback uses.
# DATASHEETINDEX_MODEL=

# Optional. The model used to caption figure regions, when it should differ
# from the one used for summaries and the ToC fallback. Unset (the default)
# means figure captioning follows that model.
#
# Worth setting when your gateway serves a cheaper vision model: captioning is
# the only per-figure cost in a build, and it is capped at 20 calls per
# document. Whether such a model exists, and what it is called, is a property
# of your gateway -- hence a setting rather than a default.
#
# Use a non-reasoning vision model, or explicitly disable reasoning below when
# the model supports it. Reasoning can exhaust the caption's 300-token budget
# before any caption text is written.
# DATASHEETINDEX_VISION_MODEL=

# Optional generation settings. Text (including structured ToCs) and vision
# reasoning are INDEPENDENT; unset/blank means omit the field, not "none".
# Supported spellings: none, minimal, low, medium, high, xhigh, max. Only set
# values supported by your gateway/model; unsupported settings are not retried
# with different parameters or sent over a different API automatically.
# DATASHEETINDEX_REASONING_EFFORT=
# DATASHEETINDEX_VISION_REASONING_EFFORT=none

# Optional positive output-token budgets, including reasoning tokens. Text and
# structured ToCs have no explicit cap by default; captions default to 300.
# Plain-text truncation raises LlmIncompleteResponseError, not a partial summary.
# DATASHEETINDEX_MAX_OUTPUT_TOKENS=
# DATASHEETINDEX_VISION_MAX_OUTPUT_TOKENS=300

# Modern Chat Completions spelling by default. Older compatible gateways can
# explicitly choose max_tokens; exactly one spelling is sent per request.
# DATASHEETINDEX_TOKEN_LIMIT_PARAMETER=max_completion_tokens

# Requests explicitly set store=false by default. "omit" leaves the field out
# for gateways that reject it. This does NOT disable gateway logging, abuse
# monitoring, or all other provider retention mechanisms.
# DATASHEETINDEX_LLM_STORE=false

# SDK-owned transport policy, shared by text, structured and vision calls.
# Retries are AFTER the initial request: 0 means one attempt, 2 means at most 3.
# There is no additional application-level HTTP retry loop.
# LITELLM_TIMEOUT_SECONDS=60
# LITELLM_MAX_RETRIES=2
